{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm exec vite build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/oauth/:path*",
      "destination": "https://solutionauth-zcgxwa4c.manus.space/api/oauth/:path*"
    },
    {
      "source": "/api/member-history",
      "destination": "https://solutionauth-zcgxwa4c.manus.space/api/member-history"
    },
    {
      "source": "/api/member-history/:path*",
      "destination": "https://solutionauth-zcgxwa4c.manus.space/api/member-history/:path*"
    },
    {
      "source": "/api/admin/members",
      "destination": "https://solutionauth-zcgxwa4c.manus.space/api/admin/members"
    },
    {
      "source": "/api/admin/members/:path*",
      "destination": "https://solutionauth-zcgxwa4c.manus.space/api/admin/members/:path*"
    },
    {
      "source": "/api/trpc/auth.:path*",
      "destination": "https://solutionauth-zcgxwa4c.manus.space/api/trpc/auth.:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://solauto1care-rmvw9wqm.manus.space/api/:path*"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "https://solauto1care-rmvw9wqm.manus.space/manus-storage/:path*"
    },
    {
      "source": "/member",
      "destination": "/"
    },
    {
      "source": "/admin/members",
      "destination": "/"
    }
  ]
}
